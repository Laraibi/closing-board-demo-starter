# Copiez ce fichier en .env. Aucun secret réel dans Git.
PORT=3000
NODE_ENV=development
# Envoi d'e-mails : laissez vide en local, les messages sont journalisés.
SMTP_URL=
MAIL_FROM="LMS démo <no-reply@example.com>"
# Heure du résumé quotidien (cron, fuseau Africa/Casablanca)
DIGEST_CRON="0 18 * * *"
